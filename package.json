{
  "name": "steatify",
  "version": "0.1.0",
  "private": true,
  "description": "Steatify — permanent Spotify Wrapped + analytics + intelligent music diary",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:generate": "npm run prisma:generate --workspace=backend",
    "db:studio": "npm run prisma:studio --workspace=backend",
    "db:seed": "npm run prisma:seed --workspace=backend"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
