# ─────────────────────────────────────────────────────────────
# Steatify — environment template. Copy to `.env` and fill values.
# Never commit the real .env. Docker Compose + apps read from it.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=steatify
POSTGRES_PASSWORD=steatify_dev_password
POSTGRES_DB=steatify
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Used by Prisma. Inside Docker network host is `postgres`, locally it's `localhost`.
DATABASE_URL=postgresql://steatify:steatify_dev_password@localhost:5432/steatify?schema=public

# --- Redis (cache + BullMQ jobs) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Backend (NestJS) ---
BACKEND_PORT=4000
# Public URL of the backend, used to build the Spotify redirect URI.
BACKEND_PUBLIC_URL=http://localhost:4000
# Where the frontend lives (for CORS + post-login redirect).
FRONTEND_URL=http://localhost:3000

# --- Auth / sessions ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_with_a_long_random_secret
JWT_ACCESS_TTL=900            # 15 min (seconds)
JWT_REFRESH_TTL=2592000       # 30 days (seconds)
# 32-byte key (base64) used to encrypt Spotify tokens at rest. openssl rand -base64 32
TOKEN_ENC_KEY=change_me_32_byte_base64_key

# --- Spotify OAuth ---
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must EXACTLY match a Redirect URI registered in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://localhost:4000/api/auth/spotify/callback

# --- ML service (FastAPI) ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000
# Optional. If set, the ML service writes weekly insights with Claude
# (claude-opus-4-8); if unset, it uses a template heuristic. Get a key at
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Steam Web API (opcional) ---
# Obtén una en https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
