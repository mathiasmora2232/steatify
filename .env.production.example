# Steatify production env template for the VPS.
# Copy to .env on the server and fill real values. Never commit the real .env.

NODE_ENV=production

# Existing SmartAhorra/Postgres admin password, used only by scripts.
DB_PASSWORD=
SHOPDB_POSTGRES_CONTAINER=shopdb-postgres
SHOPDB_ADMIN_USER=shopdb
SHOPDB_ADMIN_DB=postgres

# Steatify DB inside the existing Postgres instance.
POSTGRES_DB=steatify
POSTGRES_USER=steatify
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://steatify:replace_with_url_encoded_password@shopdb-postgres:5432/steatify?schema=public

# Optional one-time migration source. Keep only on server, never in git.
SUPABASE_DATABASE_URL=
STEATIFY_BACKUP_DIR=/root/steatify/backups/supabase
STEATIFY_KEEP_BACKUPS=5

REDIS_HOST=shopdb-redis
REDIS_PORT=6379
REDIS_URL=redis://shopdb-redis:6379/2

BACKEND_PORT=4000
BACKEND_PUBLIC_URL=https://api.steatify.lat
FRONTEND_URL=https://steatify.lat
NEXT_PUBLIC_API_URL=https://api.steatify.lat/api
BACKEND_INTERNAL_URL=http://backend:4000

JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
TOKEN_ENC_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://api.steatify.lat/api/auth/spotify/callback

ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_PORT=8000
ANTHROPIC_API_KEY=
STEAM_API_KEY=

# Token del túnel de Cloudflare (conector `cloudflared` del docker-compose.prod.yml). Se obtiene al crear el túnel «steatify» en Zero Trust.
# El deploy lo copia aquí desde el secreto de GitHub CLOUDFLARE_TUNNEL_TOKEN; o pégalo a mano.
TUNNEL_TOKEN=
