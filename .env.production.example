# Sonora production env template for the VPS.
# Copy to .env on the server and fill real values. Never commit the real .env.

NODE_ENV=production

# Existing SmartAhorra/Postgres admin password, used only by scripts.
DB_PASSWORD=
SHOPDB_POSTGRES_CONTAINER=shopdb-postgres
SHOPDB_ADMIN_USER=shopdb
SHOPDB_ADMIN_DB=postgres

# Sonora DB inside the existing Postgres instance.
POSTGRES_DB=sonora
POSTGRES_USER=sonora
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://sonora:CHANGE_ME@shopdb-postgres:5432/sonora?schema=public

# Optional one-time migration source. Keep only on server, never in git.
SUPABASE_DATABASE_URL=
SONORA_BACKUP_DIR=/root/sonora/backups/supabase
SONORA_KEEP_BACKUPS=5

REDIS_HOST=shopdb-redis
REDIS_PORT=6379
REDIS_URL=redis://shopdb-redis:6379/2

BACKEND_PORT=4000
BACKEND_PUBLIC_URL=https://api.sonora.TU_DOMINIO
FRONTEND_URL=https://sonora.TU_DOMINIO
NEXT_PUBLIC_API_URL=https://api.sonora.TU_DOMINIO/api
BACKEND_INTERNAL_URL=http://backend:4000

JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
TOKEN_ENC_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://api.sonora.TU_DOMINIO/api/auth/spotify/callback

ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_PORT=8000
ANTHROPIC_API_KEY=
STEAM_API_KEY=
